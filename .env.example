# ==============================================================================
# Argus — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Inference Provider Configuration ('groq' | 'fireworks')
# ------------------------------------------------------------------------------
INFERENCE_PROVIDER=groq

# --- Groq Provider Configuration ---
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b
# Reasoning Effort / Thinking Level: 'none' | 'low' | 'medium' | 'high' (Default: 'high')
GROQ_REASONING_EFFORT=low
# Max output tokens per turn (safeguards against 8,000 TPM rate limits; default: 6000)
GROQ_MAX_TOKENS=6000

# --- Fireworks AI Provider Configuration ---
# Get your API key from: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_BACKUP_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
# Reasoning Effort / Thinking Level for Fireworks: 'low' | 'high' | 'max' (Default: 'low')
FIREWORKS_REASONING_EFFORT=low

# Optional: Set explicit backup failover provider ('groq' | 'fireworks')
# If unset, automatically fails over to Fireworks if FIREWORKS_API_KEY is provided.
BACKUP_INFERENCE_PROVIDER=


# ------------------------------------------------------------------------------
# 2. Binance Live Public Feeds & Sandbox Configuration
# ------------------------------------------------------------------------------
# Queries 100% authentic, real-time Binance public exchange endpoints (Spot & Futures).
# Zero API keys or authentication required for market data.
# Order executions and portfolio management operate in a secure paper trading sandbox.
NEXT_PUBLIC_BINANCE_MODE=simulation


# ------------------------------------------------------------------------------
# 3. Qualitative Intelligence / Web Search (Optional for News Vector)
# ------------------------------------------------------------------------------
# Used by Analyst Scout for live breaking crypto news, catalysts, and sentiment.
# Get free key from: https://tavily.com
TAVILY_API_KEY=


# ------------------------------------------------------------------------------
# 4. x402 Protocol Sub-Account Wallet Addresses (Optional / Defaulted)
# ------------------------------------------------------------------------------
# Machine-to-machine micropayment recipient addresses for HTTP 402 invoices.
X402_ANALYST_WALLET=0x4B2A3cE892f0D9F71B04526d5257f8E53A23A4D1
X402_RISK_WALLET=0x97E8D3C89B1D50f0E72a8536f901192934D21c5F
