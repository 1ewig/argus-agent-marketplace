# ==============================================================================
# Argus — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Inference Provider (Required for Agent Intelligence)
# ------------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended models:
# - llama-3.3-70b-versatile (Default: ultra-fast, 128k context, strong tool use)
# - llama-3.1-8b-instant (Ultra-low latency lightweight option)
GROQ_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------------------------
# 2. Binance Agent OS MCP Configuration
# ------------------------------------------------------------------------------
# Mode:
# - 'simulation': Recommended for judging & demo testing. Uses live Binance market
#   depth feeds with an in-memory isolated sandbox wallet (no funding required).
# - 'live_mcp': Connects directly to Binance's official Agent OS MCP server.
NEXT_PUBLIC_BINANCE_MODE=simulation

# Official Binance Agent OS MCP Server URL
BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# Optional: Bearer authentication token for authenticated Binance Agentic Wallet access
BINANCE_AGENTIC_AUTH_TOKEN=


# ------------------------------------------------------------------------------
# 3. Qualitative Intelligence / Web Search (Optional for News Vector)
# ------------------------------------------------------------------------------
# Used by Analyst Scout for live breaking crypto news, catalysts, and sentiment.
# Get free key from: https://tavily.com
TAVILY_API_KEY=


# ------------------------------------------------------------------------------
# 4. x402 Protocol Sub-Account Wallet Addresses (Optional / Defaulted)
# ------------------------------------------------------------------------------
# Machine-to-machine micropayment recipient addresses for HTTP 402 invoices.
X402_ANALYST_WALLET=0x4B2A3cE892f0D9F71B04526d5257f8E53A23A4D1
X402_RISK_WALLET=0x97E8D3C89B1D50f0E72a8536f901192934D21c5F
